---
import '../styles/global.css';
const {skill} = Astro.props;
---

<button class="skill-display" role="button">{skill}</button>


<style>

    /*Credit: https://getcssscan.com/css-buttons-examples*/
    .skill-display {
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        border-width: 0.1em;
        border-color: #2d475d;
        background-color: #ffffff;
        color: #2d475d;
        height: 3em;
        padding-left: 1em;
        padding-right: 1em;
        font-size: 1em;
        margin: 0.5em;
    }

</style>
