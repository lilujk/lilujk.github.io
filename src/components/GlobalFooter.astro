---
import GithubIconLightBlue from '../imgs/GithubIcon-lightblue.png';
import InstagramIconLightBlue from '../imgs/InstagramIcon-lightblue.png';
import LinkedInIconLightBlue from '../imgs/LinkedInIcon-lightblue.png';

import { Image } from 'astro:assets';

import '../styles/global.css';
---

<footer>
    <div class="name-display">
        <p><b><em>Lilu Jean<br>Kaufman</em></b></p>
        <span><br>&copy; 2024 lilukaufman.com<br>All rights reserved.</span>
    </div>

    <div class="insite">
        <p><b><u>Navigation</u></b></p>
        <div class="insite-links">
            <a href="/">Home</a>
            <a href="/about/">About</a>
            <a href="/resume/">Resume</a>
            <!--<a href="/portfolio/">Portfolio</a>-->
            <a href="/#contact">Contact</a>
        </div>
    </div>

    <div class="social-links">
        <span><br><b>Get in touch!</b></span>
        <div class="social-icons">
            <a href="https://github.com/lilujk"><Image src={GithubIconLightBlue} alt="Github Icon" width="50" height="50"/></a>
            <a href="https://www.linkedin.com/in/lilu-kaufman/"><Image src={LinkedInIconLightBlue} alt="LinkedIn Icon" width="50" height="50"/></a>
            <a href="https://www.instagram.com/lilujkauf?igsh=djhzMDkxemZqNmgy&utm_source=qr"><Image src={InstagramIconLightBlue} alt="Instagram Icon" width="50" height="50"/></a>
        </div>
    </div>
</footer>

<style>

	footer {
		padding: 2em;
        padding-bottom: 8em;
        display: flex;
        text-align: center;
        justify-content: center;
        position: relative;
        background: #2d475d;
		color: #E4EEF6;
	}

    .name-display {

        text-align: left;
        padding-right: 10em;
    }
    
    .name-display p {
        font-size: 2em;
    }

    .name-display span{
        font-size: 1em;
    }

    .insite {
        text-align: center;
    }

    .insite-links {
        display: flex;
        text-align: center;
    }

    .insite-links a {
        padding: 1em;
        text-decoration: none;
        font-size: 1em;
        color: #E4EEF6;
    }

	.social-links {
		float: right;
        text-align: left;
        padding-left: 10em;
	}

    .social-icons {
        padding-top: 2em;
        display: flex;
    }

    .social-icons a {
        padding-left: 0.5em;
        padding-right: 0.5em;
    }

</style>


</style>