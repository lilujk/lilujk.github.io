---
import '../../styles/global.css';
import '../../styles/homepage.css';
import GlobalFooter from '../components/GlobalFooter.astro';

import GlobalNavbar from "../components/GlobalNavbar.astro";
import SkillCard from '../components/SkillCard.astro';

---
<html>
  <body>

    <GlobalNavbar></GlobalNavbar>

    <div class="span-photo">
        <img src="./src/imgs/businesslilutransparent.png" alt="Lilu Kaufman Professional Photo">
        <div class="intro">
            <div class="flash-text">
                <h1 class="font-change">Hello!</h1>
            </div>
            <div class="intro-statement">
                <p>I'm Lilu...</p>
            </div>
            <p>Some things about me: <br>&#128150; I love imagining, creating, and learning. <br>&#128187; I'm a full-stack software developer.<br>&#127912; I do art digitally and traditionally. <br> <br>&#128075; Welcome to my website!</p>
        </div>
    </div>

    <div class="profile">
        <div class="pre-bio">
            <h1><b>My Skills</b></h1>
                <div class="skill-list">
                <SkillCard skill={"Astro.js"}/>
                <SkillCard skill={"TypeScript"}/>
                <SkillCard skill={"Tailwind CSS"}/>

                <SkillCard skill={"Python"}/>
                <SkillCard skill={"C++"}/>
                <SkillCard skill={"Java"}/>
                <SkillCard skill={"HTML/CSS"}/>
                <SkillCard skill={"JavaScript"}/>

                <SkillCard skill={"Procreate"}/>
                <SkillCard skill={"Paint Tool SAI"}/>
                <SkillCard skill={"FireAlpaca"}/>
                <h2>&#10024; A <em>little</em> about me &#x2728;</h2>
                <p>From data structures to drawing I have a passion for seeing ideas become tangible. The versatility of technology inspires me everyday pursuing my dual major of Computer Science and Information Technologies and Web Sciences at Rensselear Polytechnic Institute.</p>
                <a href="#">Continue reading my bio...</a>
            </div>
        </div>
        <div class="self-portrait">
            <img src="./src/imgs/artlilu.png" alt="Lilu Kaufman Self Portrait Photo">
        </div>
        <div class="pre-projects">

        </div>
    </div>

    <!--<GlobalFooter></GlobalFooter>-->

  </body>
</html>