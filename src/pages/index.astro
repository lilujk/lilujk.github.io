---
import '../styles/global.css';
import '../styles/homepage.css';

import { Image } from 'astro:assets';
import BusinessTransparentPhoto from '../imgs/BusinessTransparentPhoto.png';
import BusinessCasualPhoto from '../imgs/BusinessCasualPhoto.png';
import coffeeCup from '../imgs/CoffeeCup.png';
import GithubIconBlue from '../imgs/GithubIcon-blue.png';
import InstagramIconBlue from '../imgs/InstagramIcon-blue.png';
import LinkedInIconBlue from '../imgs/LinkedInIcon-blue.png';
import SoapboxLogo from '../imgs/SoapboxLogo.png';
import HelpHerStemLogo from '../imgs/HelpHerSTEMLogo.png';
import LCOSLogo from '../imgs/LCOSLogo.png';
import CentTrackLogo from '../imgs/CentTrackLogo.png';

import GlobalNavbar from "../components/GlobalNavbar.astro";
import SkillCard from '../components/SkillCard.astro';
import GlobalFooter from '../components/GlobalFooter.astro';
import ContactButton from '../components/ContactButton.astro';
---
<html>
  <body>

    <GlobalNavbar />

    <div class="span-photo">]
        <Image 
            class="span-photo-img"
            src={BusinessTransparentPhoto} 
            alt="Lilu Kaufman in Professional Clothes"
        />
        <div class="intro">
            <div class="flash-text">
                <h1 class="font-change">Hello!</h1>
            </div>
            <div class="intro-statement">
                <p>I'm Lilu...</p>
            </div>
            <p>Some things about me: <br>&#128150; I love imagining, creating, and learning. <br>&#128187; I'm a full-stack software developer.<br>&#127912; I do art digitally and traditionally. <br> <br>&#128075; Welcome to my website!</p>
        </div>
    </div>

    <div class="profile">
        <div class="pre-bio">
            <h1><b>My Skills</b></h1>
                <div class="skill-list">
                <SkillCard skill={"Astro.js"}/>
                <SkillCard skill={"TypeScript"}/>
                <SkillCard skill={"Tailwind CSS"}/>
                    <br>
                <SkillCard skill={"Python"}/>
                <SkillCard skill={"C++"}/>
                <SkillCard skill={"Java"}/>
                <SkillCard skill={"HTML/CSS"}/>
                <SkillCard skill={"JavaScript"}/>
                    <br>
                <SkillCard skill={"Procreate"}/>
                <SkillCard skill={"Paint Tool SAI"}/>
                <SkillCard skill={"FireAlpaca"}/>
                <h2>&#10024; A <em>little</em> about me &#x2728;</h2>
                <p>From data structures to drawing I have a passion for seeing ideas become tangible. The versatility of technology inspires me everyday pursuing my dual major of Computer Science and Information Technologies and Web Sciences at Rensselear Polytechnic Institute.</p>
                <a href="/about/">Continue reading my bio...</a>
            </div>
        </div>
        <div class="self-portrait">
            <Image 
                src={BusinessCasualPhoto} 
                alt="Lilu Kaufman in Business Casual Clothes"
            />
        </div>
    </div>

    <div class="projects">
        <h1><b>My Projects</b></h1>

        <div class="project">
            <div class="project-logo">
                <Image 
                src={SoapboxLogo}
                alt="Soapbox Logo"
                width="250"
                height="250"
                />
            </div>
            <div class="project-desc">
                <h2>Soap&#183;box Hosting</h2>
                <h3><em>Software Engineer Intern</em></h3>
                <p>Developed podcast hosting platform using <u>Astro JS</u>, <u>Prisma ORM</u>, and background job workers.</p>
                <a href="https://www.soapbox.host/">View This Project!</a>
            </div>
        </div>
        <div class="project">
            <div class="project-logo">
            <Image 
                src={HelpHerStemLogo}
                alt="Help Her STEM Logo"
                width="250"
                height="250"
            />
            </div>
            <div class="project-desc">
                <h2>Help Her STEM: Anonomyous Advice Forum</h2>
                <h3><em>Full-Stack Developer/Concept Lead</em></h3>
                <p>Designed and implemented an anonymous advice forum for underrepresented gender minorities in STEM using basic <u>HTML</u> and <u>CSS</u>, <u>Balsamiq</u> mock-ups, and dynamic <u>JSON</u> file reading/writing.</p>
                <a href="https://github.com/RPI-ITWS/ITWS1100-S24-team1">View This Project!</a>
            </div>
        </div>
        <div class="project">
            <div class="project-logo">
            <Image 
                src={LCOSLogo}
                alt="LCOS Logo"
                width="250"
                height="250"
            />
            </div>
            <div class="project-desc">
                <h2>LCOS: Lethal Company Open Source</h2>
                <h3><em>Developer/UX Designer</em></h3>
                <p>Created custom modifications, UX design in <u>Procreate</u>, and 3D modeled in <u>Blender</u> for the popular video game "Lethal Company."</p>
                <a href="https://github.com/LCOS-Lethal-Company-Open-Source/LCOS-Designs">View This Project!</a>
            </div>
        </div>
        <div class="project">
            <div class="project-logo">
            <Image 
                src={CentTrackLogo}
                alt="CentTrack Logo"
                width="250"
                height="250"
            />
            </div>
            <div class="project-desc">
                <h2>CentTrack: Financial Tracker</h2>
                <h3><em>Developer/ Concept Lead</em></h3>
                <p>Designed a financial tracker with a 4-person team using <u>React Native</u> during a 24+ hour hackathon, awarded 'Best Mobile App.'</p>
                <a href="https://devpost.com/software/track-xnat9j">View This Project!</a>
            </div>
        </div>
        <h1><em>...and many more coming soon!</em></h1>
    </div>

    <div id="contact">
        <p><b>Let's chat, get in <em>contact!</em> &#9749;</b></p>
        <div class="social-icons">
            <div class="icons">
                <a href="https://github.com/lilujk"><Image src={GithubIconBlue} alt="Github Icon" width="64" height="64"/></a>
                <a href="https://www.linkedin.com/in/lilu-kaufman/"><Image src={LinkedInIconBlue} alt="LinkedIn Icon" width="64" height="64"/></a>
                <a href="https://www.instagram.com/lilujkauf?igsh=djhzMDkxemZqNmgy&utm_source=qr"><Image src={InstagramIconBlue} alt="Instagram Icon" width="64" height="64"/></a>
            </div>
            <div class="icon-labels">
                <a href="https://github.com/lilujk"><ContactButton socialName={"Github"} /></a>
                <a href="https://www.linkedin.com/in/lilu-kaufman/"><ContactButton socialName={"LinkedIn"} /></a>
                <a href="https://www.instagram.com/lilujkauf?igsh=djhzMDkxemZqNmgy&utm_source=qr"><ContactButton socialName={"Instagram"} /></a>
            </div>
        </div>
    </div>

    <GlobalFooter/>

  </body>

  <!-- TO DO: Make Mobile Accessible! -->
</html>